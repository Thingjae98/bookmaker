# SweetBook Book Print API Key
# Sandbox 환경: https://api-sandbox.sweetbook.com/v1
# Live 환경: https://api.sweetbook.com/v1
SWEETBOOK_API_KEY=your_sandbox_api_key_here
SWEETBOOK_API_BASE_URL=https://api-sandbox.sweetbook.com/v1

# Google Gemini API Key (AI 텍스트 생성 기능)
# 발급: https://aistudio.google.com/app/apikey (무료 티어 사용 가능)
GEMINI_API_KEY=your_gemini_api_key_here

# SweetBook Webhook Secret Key (선택 — HMAC-SHA256 서명 검증)
# PUT /webhooks/config 호출 시 SweetBook이 자동 발급하는 secretKey 값
# 미설정 시 서명 검증을 스킵하고 모든 요청을 수용 (개발 환경용)
SWEETBOOK_WEBHOOK_SECRET=
